generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ============ ENUMS (stored as String in SQLite) ============

// 8 niveaux d'acces FEUA (du plus haut au plus bas)
// CEO > Mast In > Mast > Master > Mix > Min > AMC > IGN
enum AccessLevel {
  CEO
  MAST_IN
  MAST
  MASTER
  MIX
  MIN
  AMC
  IGN
}

enum MemberStatus {
  ACTIVE
  SUSPENDED
  ARCHIVED
  PENDING_VALIDATION
  IGNORANT
}

enum DocumentType {
  CARTE_ETUDIANT
  FICHE_PRE_INSCRIPTION
  BULLETIN
  CERTIFICAT
  AUTRE
}

enum CashRegisterType {
  PRINCIPALE
  UNIFORMES
  SERVICES_NUMERIQUES
  EVENEMENTS
}

enum TransactionType {
  DEPOSIT
  WITHDRAWAL
  PAYMENT
  TRANSFER
  REFUND
}

enum TransactionStatus {
  PENDING
  COMPLETED
  FAILED
  CANCELLED
}

enum MessageScope {
  PLENIARY
  PRIVATE
}

enum UniformOrderStatus {
  EN_ATTENTE
  VAL1
  VAL2
  LIVRE
  ANNULE
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  LOGIN
  LOGOUT
  LOGIN_FAILED
  ROLE_CHANGE
  STATUS_CHANGE
  PAYMENT
  WITHDRAWAL
  DOCUMENT_UPLOAD
  DOCUMENT_DOWNLOAD
  MESSAGE_SEND
  ARCHIVE
  EXPORT
  SYSTEM
  UNIFORM_ORDER
}

enum NotificationChannel {
  IN_APP
  EMAIL
  WHATSAPP
  PUSH
}

enum NotificationStatus {
  UNREAD
  READ
}

// ============ MODELS ============

model Member {
  id              String       @id @default(cuid())
  matricule       String       @unique
  firstName       String
  lastName        String
  email           String       @unique
  phone           String?
  passwordHash    String
  accessLevel     AccessLevel  @default(MIN)
  status          MemberStatus @default(PENDING_VALIDATION)
  institution     String?
  filiere         String?
  niveau          String?
  dateOfBirth     DateTime?
  photoUrl        String?
  address         String?
  city            String?
  country         String       @default("Benin")
  ficheSoumise    Boolean      @default(false)
  carteEtudiant   Boolean      @default(false)
  lastLoginAt     DateTime?
  loginAttempts   Int          @default(0)
  lockedUntil     DateTime?
  recoveryCode    String?
  recoveryExpiry  DateTime?
  invitedBy       String?
  validatedBy     String?
  validatedAt     DateTime?
  notes           String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  // Relations
  sentMessages       Message[]        @relation("MessageSender")
  receivedMessages   MessageRecipient[]
  documents          Document[]
  cashTransactions   CashTransaction[] @relation("TransactionMember")
  uniformOrders      UniformOrder[]
  notifications      Notification[]
  auditLogs          AuditLog[]       @relation("AuditActor")
  validatedMembers   Member[]         @relation("ValidatorMember")
  validator          Member?          @relation("ValidatorMember", fields: [validatedBy], references: [id])
  createdRegisters   CashRegister[]   @relation("RegisterCreator")
  validatedTransactions CashTransaction[] @relation("TransactionValidator")
  validatedUniforms1 UniformOrder[]    @relation("UniformValidator1")
  validatedUniforms2 UniformOrder[]    @relation("UniformValidator2")

  @@index([matricule])
  @@index([email])
  @@index([accessLevel])
  @@index([status])
  @@index([institution])
  @@index([createdAt])
}

model Document {
  id            String        @id @default(cuid())
  title         String
  description   String?
  type          DocumentType  @default(AUTRE)
  fileName      String
  fileSize      Int
  mimeType      String
  fileUrl       String
  memberId      String
  downloadCount Int           @default(0)
  isPublic      Boolean       @default(false)
  anneeScolaire String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  member Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@index([memberId])
  @@index([type])
  @@index([createdAt])
}

model DocumentDownload {
  id         String   @id @default(cuid())
  documentId String
  memberId   String?
  ipAddress  String?
  isPaid     Boolean  @default(false)
  amount     Int      @default(0)
  createdAt  DateTime @default(now())

  @@index([documentId])
  @@index([memberId])
}

model CashRegister {
  id          String             @id @default(cuid())
  name        String
  type        CashRegisterType  @default(PRINCIPALE)
  description String?
  balance     Int                @default(0)
  isActive    Boolean            @default(true)
  createdBy   String
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  creator       Member            @relation("RegisterCreator", fields: [createdBy], references: [id])
  transactions  CashTransaction[]

  @@index([type])
  @@index([isActive])
}

model CashTransaction {
  id              String            @id @default(cuid())
  registerId      String
  memberId        String
  type            TransactionType
  amount          Int
  description     String?
  reference       String?
  status          TransactionStatus @default(PENDING)
  paymentMethod   String?           // MTN_MOMO, MOOV_MONEY, CARTE, ESPECES
  validatedBy     String?
  validatedAt     DateTime?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  register  CashRegister @relation(fields: [registerId], references: [id], onDelete: Cascade)
  member    Member       @relation("TransactionMember", fields: [memberId], references: [id])
  validator  Member?      @relation("TransactionValidator", fields: [validatedBy], references: [id])

  @@index([registerId])
  @@index([memberId])
  @@index([type])
  @@index([status])
  @@index([createdAt])
}

model Message {
  id        String       @id @default(cuid())
  scope     MessageScope @default(PLENIARY)
  content   String
  senderId  String
  createdAt DateTime     @default(now())

  sender     Member              @relation("MessageSender", fields: [senderId], references: [id])
  recipients MessageRecipient[]

  @@index([scope])
  @@index([senderId])
  @@index([createdAt])
}

model MessageRecipient {
  id        String   @id @default(cuid())
  messageId String
  recipientId String
  isRead    Boolean  @default(false)
  readAt    DateTime?

  message   Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  recipient Member  @relation(fields: [recipientId], references: [id], onDelete: Cascade)

  @@unique([messageId, recipientId])
  @@index([recipientId])
  @@index([isRead])
}

model UniformOrder {
  id            String             @id @default(cuid())
  memberId      String?
  cycle         Int                @default(1) // 1ere, 2eme, Neme annee
  taille        String?
  quantity      Int                @default(1)
  status        UniformOrderStatus @default(EN_ATTENTE)
  totalAmount   Int                @default(0)
  paymentMethod String?
  paymentRef    String?
  notes         String?
  validated1By  String?
  validated1At  DateTime?
  validated2By  String?
  validated2At  DateTime?
  livredAt      DateTime?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  member       Member? @relation(fields: [memberId], references: [id])
  validator1   Member? @relation("UniformValidator1", fields: [validated1By], references: [id])
  validator2   Member? @relation("UniformValidator2", fields: [validated2By], references: [id])

  @@index([memberId])
  @@index([status])
  @@index([cycle])
  @@index([createdAt])
}

model AuditLog {
  id         String       @id @default(cuid())
  action     AuditAction
  actorId    String?
  entityType String?
  entityId   String?
  details    String?      // JSON string for additional context
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime     @default(now())

  actor Member? @relation("AuditActor", fields: [actorId], references: [id])

  @@index([actorId])
  @@index([action])
  @@index([entityType])
  @@index([createdAt])
}

model Announcement {
  id        String   @id @default(cuid())
  title     String
  content   String
  isUrgent  Boolean  @default(false)
  isActive  Boolean  @default(true)
  createdBy String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive])
  @@index([isUrgent])
  @@index([createdAt])
}

model Notification {
  id               String              @id @default(cuid())
  memberId         String
  title            String
  content          String
  channel          NotificationChannel @default(IN_APP)
  status           NotificationStatus  @default(UNREAD)
  link             String?
  createdAt        DateTime            @default(now())

  member Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@index([memberId])
  @@index([status])
  @@index([createdAt])
}

model InvitationCode {
  id        String   @id @default(cuid())
  code      String   @unique
  email     String   @unique
  phone     String?
  invitedBy String
  usedAt    DateTime?
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([code])
  @@index([email])
  @@index([usedAt])
}

model AnnualArchive {
  id            String   @id @default(cuid())
  anneeScolaire String   @unique
  memberCount   Int      @default(0)
 archiveData   String   // JSON string with archived member data
  createdAt     DateTime @default(now())

  @@index([anneeScolaire])
}

model IndisciplineRecord {
  id        String   @id @default(cuid())
  memberId  String
  reason    String
  recordedBy String
  createdAt DateTime @default(now())

  @@index([memberId])
}
